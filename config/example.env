# Secrets may be plain values or 1Password secret references (op://vault/item/field).
# The run*.sh scripts resolve references with `op run` using your own 1Password
# account (desktop app). Prod resolves them in-process via OP_SERVICE_ACCOUNT_TOKEN.

SPROBOT_DISCORD_TOKEN=op://dev tokens/discord-sprobot/token
STICKYBOT_DISCORD_TOKEN=op://dev tokens/discord-stickybot/token
THREADBOT_DISCORD_TOKEN=op://dev tokens/discord-threadbot/token

S3_KEY=op://dev tokens/linode-s3/access_key
S3_SECRET=op://dev tokens/linode-s3/secret_key
S3_ENDPOINT=XXXXXX
S3_BUCKET=XXXXXX

WEB_ENDPOINT=http://localhost:8080/

SPROBOT_HEALTHCHECK_ENDPOINT=
STICKYBOT_HEALTHCHECK_ENDPOINT=
THREADBOT_HEALTHCHECK_ENDPOINT=
